{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leetcode-daily-solver",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",
  // state machine heartbeat: every minute; the daily gate (03:31 UTC) starts the run
  "triggers": {
    "crons": ["* * * * *"]
  },
  "kv_namespaces": [
    { "binding": "STATE", "id": "235b0632dc9e4cef951c9c219e718ffa" }
  ],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
