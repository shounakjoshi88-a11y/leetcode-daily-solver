{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "leetcode-daily-solver",
  "main": "src/worker.js",
  "compatibility_date": "2026-01-01",
  // daily run at 09:00 IST == 03:30 UTC
  "triggers": {
    "crons": ["30 3 * * *"]
  },
  "kv_namespaces": [
    { "binding": "STATE", "id": "REPLACE_WITH_KV_ID" }
  ],
  "ai": { "binding": "AI" },
  "observability": { "enabled": true }
}
